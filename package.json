{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:contracts": "pnpm --dir packages/cms-contracts build",
    "dev": "next dev",
    "build": "next build",
    "generate:theme": "pnpm --dir packages/design-system generate",
    "test:theme": "pnpm --dir packages/design-system test",
    "predev": "pnpm generate:contracts",
    "prebuild": "pnpm generate:contracts && pnpm generate:theme",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "check:backend": "node scripts/check-backend.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@calcom/embed-react": "1.5.3",
    "@fs/cms-contracts": "file:packages/cms-contracts",
    "@fs/design-system": "file:packages/design-system",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.14.0"
}
